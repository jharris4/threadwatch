[Unit]
Description=threadwatch web: day-by-day event review pages
# time-sync.target, as for threadwatch.service: a Pi has no RTC, and the
# pages tell today's time from the clock.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
# __USER__ and __REPO__ are filled in by bin/setup-host.sh (or by hand; see
# threadwatch.service for the one-liner).
User=__USER__
WorkingDirectory=__REPO__
# Read-only over the state directory; a separate process so a page bug can
# never touch capture. Listen address and port: [web] in config.toml.
ExecStart=__REPO__/bin/threadwatch web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
