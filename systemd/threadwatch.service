[Unit]
Description=threadwatch: continuous Thread/802.15.4 capture and storm detection
# time-sync.target: a Pi has no RTC and boots on its saved clock; starting
# before NTP corrects it stamps frames, events and ring files with the
# wrong time. On its own the target only waits for timesyncd to start;
# bin/setup-host.sh enables systemd-time-wait-sync with a 120 s bound so
# it waits for the sync itself, and no longer than that when offline.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# A recorder that cannot start (no credentials, wrong channel, no dongle)
# exits within seconds. systemd's default start limit is 5 starts in 10 s,
# which RestartSec=10 plus the 2 s ExecStartPre can never reach, so such a
# unit would restart every 12 s for ever, never "failed", and a monitor
# watching unit state would see nothing wrong. Ten fast failures in ten
# minutes (about two minutes of them) settle it into failed instead; the
# stall watchdog's exits are minutes apart and never trip this. To start
# again after the cause is fixed: systemctl reset-failed threadwatch
# (bin/setup-host.sh does).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# __USER__ and __REPO__ are filled in by bin/setup-host.sh. To install by hand:
#   sed -e 's|__USER__|you|' -e 's|__REPO__|/where/you/cloned/threadwatch|' \
#       systemd/threadwatch.service | sudo tee /etc/systemd/system/threadwatch.service
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/bin/threadwatch capture
# Alert/heartbeat secrets (optional; see config/alerts.example.env).
EnvironmentFile=-__REPO__/config/alerts.env
Restart=always
RestartSec=10
# The dongle re-enumerates on replug; give udev a moment.
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
