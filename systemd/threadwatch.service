[Unit]
Description=threadwatch: continuous Thread/802.15.4 capture and storm detection
# time-sync.target: a Pi has no RTC and boots on its saved clock; starting
# before NTP corrects it stamps frames, events and ring files with the
# wrong time. (To make the target wait for an actual sync rather than for
# timesyncd to start: systemctl enable systemd-time-wait-sync.)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
# __USER__ and __REPO__ are filled in by bin/setup-host.sh. To install by hand:
#   sed -e 's|__USER__|you|' -e 's|__REPO__|/where/you/cloned/threadwatch|' \
#       systemd/threadwatch.service | sudo tee /etc/systemd/system/threadwatch.service
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/bin/threadwatch capture
# Alert/heartbeat secrets (optional; see config/alerts.example.env).
EnvironmentFile=-__REPO__/config/alerts.env
Restart=always
RestartSec=10
# The dongle re-enumerates on replug; give udev a moment.
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
